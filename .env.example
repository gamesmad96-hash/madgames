NEXT_PUBLIC_SITE_URL=https://www.madgames.fun

# Search Console ownership verification (optional until configured)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Supabase (required for persistent production data)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Optional server-only aliases supported by the app
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Admin login - use long random values in production
ADMIN_PASSWORD=
ADMIN_SESSION_TOKEN=

# Provider feed URLs are intentionally not hardcoded.
# Paste official GameMonetize/GameDistribution publisher feed URLs in /admin/import.
GAMEMONETIZE_FEED_URL=
GAMEDISTRIBUTION_FEED_URL=

# Analytics / ads (optional)
NEXT_PUBLIC_GA_ID=
H5_GAME_ADS_ENABLED=false
GOOGLE_H5_AD_CLIENT=
